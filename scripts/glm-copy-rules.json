{
  "claim_tokens_regex": "\\b(?:(?:is|are|was|were|be|being|as|becomes?|remains?)\\s+(?:the\\s+|our\\s+)?(?:first|only|sole)\\b(?![- ]token)|the\\s+(?:first|only|sole)\\s+(?:[\\w.=-]+\\s+){0,3}?(?:build|recipe|port|release|project|engine|implementation|way|setup|server|stack|one|TP ?=?3|TP3)\\b|first\\s+(?:to|ever|public|open|known|working)\\b|first-ever|only\\s+(?:one|recipe|build|project|release|engine|implementation|setup|known|working)\\b|unique(?:ly)?\\s+(?:to|among|in\\s+(?:the|being))\\b|uniquely|no\\s+one\\s+else|nobody\\s+else|no\\s+other\\s+(?:recipe|build|project|engine|release|setup|implementation)|world'?s\\s+first|the\\s+TP3\\s+port)",
  "claim_subject_regex": "\\b(DGX Sparks?|Sparks?|TP ?=?3|TP3|tensor[- ]parallel\\w*|three[- ](hosts|nodes|machines|boxes|Sparks)|cluster|TensorFold|upstream|engine|concurren\\w*|tool[- ]call\\w*|port(ed|s)?|build|quant\\w*|EXL3|recipe|release|project|GLM)\\b",
  "comparison_target_regex": "\\b(vLLM|llama\\.cpp|llama-server|SGLang|ExLlama\\w*|TabbyAPI|Ollama|mlx[_-]?lm|LM ?Studio|TGI|TensorRT[- ]LLM|Mia\\w*|Tony|Kai|upstream TensorFold|TensorFold v?[1-9]\\.[0-9]+)\\b",
  "comparison_word_regex": "\\b(?:faster|slower|quicker|than|vs\\.?|versus|compared|comparison|beats?|outperform\\w*|ahead of|behind|unlike|lacks?|lacking|missing|no support|(?:down|up)\\s+from|(?:does not|doesn'?t|did not|didn'?t|cannot|can'?t) (?:support|have|offer|do|run|serve))\\b|(?<![\\w./])(?<![A-Za-z]-)\\d+(?:\\.\\d+)?\\s*[x×](?![\\w/-]|\\s*\\d)",
  "provenance_origin_regex": "\\b(?:fork(?:ed)?\\s+(?:of|from)|based\\s+on|built\\s+on|derived\\s+from|ported\\s+from|adapted\\s+from|(?:a|the|our)\\s+(?:[\\w-]+\\s+){0,2}?fork|\\(fork\\))\\b",
  "allow_sentences": [
    {
      "sentence": "**Only one release runs at a time.**",
      "surfaces": [
        "docs/OPERATIONS.md"
      ],
      "rules": [
        "claims"
      ],
      "reason": "operational limit (one release's containers at a time), not a uniqueness claim"
    }
  ],
  "allow_patterns": [
    {
      "regex": "lines ported from upstream TensorFold",
      "rules": [
        "provenance",
        "claims"
      ],
      "reason": "names the origin of two Apache-2.0 lines ported from later upstream code (credited in NOTICE), not the engine's base; the same sentence states the base elsewhere"
    },
    {
      "regex": "(?:adapted from upstream TensorFold|upstream TensorFold server fix|ashhart/TensorFold/commit/)",
      "rules": [
        "provenance",
        "claims"
      ],
      "reason": "credits for specific upstream commits that were ported"
    },
    {
      "regex": "(?:now TensorFold on Hugging Face|huggingface\\.co/TensorFold|\\bTensorFold/GLM-)",
      "rules": [
        "provenance"
      ],
      "reason": "the weights publisher's Hugging Face org, not the engine"
    },
    {
      "regex": "kernel-cache/tensorfold",
      "rules": [
        "provenance",
        "claims"
      ],
      "reason": "a filesystem path"
    },
    {
      "regex": "\\bV-(?:code|chat)/\\d\\d-[a-z0-9-]+",
      "rules": [
        "claims",
        "comparisons"
      ],
      "reason": "prompt IDs in the byte-pinned measured prompt mix"
    }
  ]
}
