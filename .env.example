# Numeric GA4 property ID (not the G- measurement ID).
GA_PROPERTY_ID=

# Full Google service-account key JSON, stored as one environment variable.
GA_SERVICE_ACCOUNT_JSON=

# Bearer token for both /api/viewadmin handlers; set in Vercel before deploy.
VIEWADMIN_TOKEN=

# Kill switch for POST /api/views live-counter writes; only exactly '1' enables.
VIEW_WRITES_ENABLED=0

# IANA timezone of the GA4 property; defaults to America/Chicago when unset.
GA_PROPERTY_TIME_ZONE=
